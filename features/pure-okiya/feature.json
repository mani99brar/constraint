{
  "version": "2.3.0",
  "name": "Pure Okiya: Constraint plays the rules v1.0 (take a matching tile, place a token, win by line, square or blockade), with an Easy, Normal and perfect Hard bot on the tabletop interface",
  "branch_prefix": "feature/pure-okiya",
  "prd": "docs/prd.md",
  "policy": "policy.json",
  "workers": [
    {
      "node_id": "bot",
      "task": "bot-task.md"
    },
    {
      "node_id": "web",
      "task": "web-task.md"
    }
  ],
  "reviewers": [
    {
      "reviewer_id": "general",
      "prompt": "builtin:general"
    },
    {
      "reviewer_id": "coverage",
      "prompt": "builtin:coverage"
    }
  ],
  "sidecar": {
    "prompt": "builtin:senior-review",
    "cadence_seconds": 300,
    "pass_timeout_seconds": 300,
    "max_passes": 48
  }
}
