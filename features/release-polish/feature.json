{
  "version": "2.3.0",
  "name": "Release polish: Constraint as a publishable static web game, with the playtest helpers removed, a How to Play dialog, a highlight toggle, synthesized sound, match resume, local stats and the open review findings fixed",
  "branch_prefix": "feature/release-polish",
  "prd": "docs/prd.md",
  "policy": "policy.json",
  "workers": [
    {
      "node_id": "engine",
      "task": "engine-task.md"
    },
    {
      "node_id": "web",
      "task": "web-task.md"
    }
  ],
  "reviewers": [
    {
      "reviewer_id": "general",
      "prompt": "builtin:general"
    },
    {
      "reviewer_id": "coverage",
      "prompt": "builtin:coverage"
    }
  ],
  "sidecar": {
    "prompt": "builtin:senior-review",
    "cadence_seconds": 300,
    "pass_timeout_seconds": 300,
    "max_passes": 48
  }
}
