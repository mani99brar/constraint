{
  "version": "1.2.0",
  "feature": "Okiya walking skeleton",
  "independent_review": true,
  "integration_approval": true,
  "max_verification_attempts": 3,
  "setup": [
    {
      "argv": [
        "npm",
        "ci"
      ],
      "timeout_seconds": 900
    }
  ],
  "workers": [
    {
      "node_id": "main",
      "role": "fullstack",
      "required_check_kinds": [
        "typecheck",
        "unit",
        "build",
        "browser"
      ],
      "owned_paths": [
        "package.json",
        "package-lock.json",
        "tsconfig.json",
        "tsconfig.base.json",
        "vitest.config.ts",
        ".gitignore",
        ".npmrc",
        "README.md",
        "CLAUDE.md",
        "docs/architecture.md",
        "apps",
        "packages",
        "tests",
        "scripts"
      ],
      "checks": [
        {
          "id": "typecheck",
          "kind": "typecheck",
          "argv": [
            "npm",
            "run",
            "typecheck"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "unit",
          "kind": "unit",
          "argv": [
            "npm",
            "run",
            "test:unit"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "build",
          "kind": "build",
          "argv": [
            "npm",
            "run",
            "build"
          ],
          "timeout_seconds": 600,
          "scenarios": []
        },
        {
          "id": "browser",
          "kind": "browser",
          "argv": [
            "npx",
            "--no-install",
            "playwright",
            "test",
            "--config=tests/e2e/playwright.config.ts"
          ],
          "timeout_seconds": 600,
          "scenarios": [
            {
              "id": "start-match",
              "description": "The landing page starts a match against the bot; the page shows 16 cells with their terrain and symbol, the opening rule in place of a constraint, and whose turn it is."
            },
            {
              "id": "legal-turn",
              "description": "The player deploys onto a highlighted edge cell; the constraint shows that tile's pair; the bot replies with a legal action and the turn returns to the player. Clicking a non-matching cell shows the refusal reason and leaves the turn unchanged."
            }
          ]
        }
      ]
    }
  ]
}
