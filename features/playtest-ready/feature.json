{
  "version": "2.3.0",
  "name": "Playtest-ready Okiya: a better UI and UX (visual design, turn clarity, action feedback, onboarding), presets, scenarios and bot depth chosen at start, phone layout, keyboard play, and the bot's open review findings",
  "branch_prefix": "feature/playtest-ready",
  "prd": "docs/prd.md",
  "policy": "policy.json",
  "workers": [
    {
      "node_id": "engine",
      "task": "engine-task.md"
    },
    {
      "node_id": "ux",
      "task": "ux-task.md"
    }
  ],
  "reviewers": [
    {
      "reviewer_id": "general",
      "prompt": "builtin:general"
    },
    {
      "reviewer_id": "coverage",
      "prompt": "builtin:coverage"
    }
  ],
  "sidecar": {
    "prompt": "builtin:senior-review",
    "cadence_seconds": 300,
    "pass_timeout_seconds": 300,
    "max_passes": 48
  }
}
